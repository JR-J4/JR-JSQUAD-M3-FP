<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="panel question-panel">
    <p class="eyebrow">// ПРОТОКОЛ СПІВБЕСІДИ · <c:out value="${game.lives}"/> НЕРВОВІ КЛІТИНИ</p>
    <h1><c:out value="${question.title}"/></h1>
    <p class="question-prompt"><c:out value="${questionPrompt}"/></p>
    <form method="post" action="${pageContext.request.contextPath}/quest">
        <input type="hidden" name="action" value="answer">
        <input type="hidden" name="questionNumber" value="${question.number}">
        <fieldset class="answers">
            <legend>Обери відповідь:</legend>
            <c:forEach var="answer" items="${question.answers}" varStatus="loop">
                <label class="answer-option">
                    <input type="radio" name="answerNumber" value="${loop.count}" required>
                    <span><c:out value="${answer}"/></span>
                </label>
            </c:forEach>
        </fieldset>
        <button type="submit" class="button">Надіслати відповідь</button>
    </form>
</section>
